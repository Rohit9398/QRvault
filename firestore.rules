rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - users can only read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // QR Codes collection
    match /qrCodes/{qrDocId} {
      // Read access: Owner can read, or anyone can read active/inactive QR for redirect & activation
      allow read: if (request.auth != null && resource.data.ownerId == request.auth.uid) || true;
      
      // Users can only create QR codes with their own UID as ownerId
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      
      // Update access: Owner can update their QR, or public scanner can increment scanCount, or activation
      allow update: if (request.auth != null && resource.data.ownerId == request.auth.uid)
                   || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scanCount', 'updatedAt']))
                   || (resource.data.status == 'inactive' && request.resource.data.status == 'active');
      
      // Users can only delete their own QR codes
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      
      // Scans subcollection - allow read for QR owner, allow create for anyone (scan tracking)
      match /scans/{scanId} {
        allow read: if request.auth != null;
        allow create: if true; // Anyone scanning can create a scan record
      }
    }
    
    // Public read access for QR redirect lookup (by qrId field)
    // This is handled server-side via API routes, so no public rules needed
  }
}
